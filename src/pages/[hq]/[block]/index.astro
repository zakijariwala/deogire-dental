---
/**
 * HQ block page: every prospect in the block, funnel status, data gaps, and
 * the shareable demo link. Operator-only (rule 7).
 */
import { getCollection } from 'astro:content';
import HqLayout from '../../../layouts/HqLayout.astro';
import { BLOCK_IDS, BUILT_BLOCKS, HQ_SECRET, blockMeta, demoPath, type ClinicData } from '../../../lib/site';

export async function getStaticPaths() {
  return BLOCK_IDS.map((block) => ({ params: { hq: `hq-${HQ_SECRET}`, block } }));
}

const { block } = Astro.params;
const meta = blockMeta(block!);
const built = (BUILT_BLOCKS as readonly string[]).includes(block!);
const clinics = (await getCollection('clinics')).filter((c) => c.data.block_id === block);

function gapCount(c: ClinicData): number {
  return Object.values(c.data_status).filter((v) => v === 'missing').length;
}
---

<HqLayout title={`HQ | ${meta.specialty}`}>
  <a href={`/hq-${HQ_SECRET}/`} class="text-sm text-(--c-muted) underline-offset-4 hover:underline">Back to all blocks</a>
  <h1 class="mt-3 text-2xl font-semibold">{meta.specialty}</h1>
  <p class="mt-1 text-sm text-(--c-muted)">
    {built ? 'Template ready. Share individual demo links below.' : 'Template not built yet (Phase 4). Prospects can be loaded meanwhile.'}
  </p>

  {
    clinics.length === 0 ? (
      <p class="mt-8 rounded-2xl border-2 border-dashed border-black/15 px-6 py-8 text-sm text-(--c-muted)">
        No prospects loaded for this block yet. Add a clinic JSON under /data/clinics to see it here.
      </p>
    ) : (
      <ul class="mt-8 divide-y divide-black/10 rounded-2xl border border-black/10 bg-(--c-surface)">
        {clinics.map((c) => (
          <li class="px-5 py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <p class="font-medium">{(c.data.display_name as string) ?? c.data.slug}</p>
              <span class="rounded-full bg-zinc-100 px-3 py-1 text-xs font-semibold text-zinc-600">{c.data.prospect_status}</span>
            </div>
            <p class="mt-1 text-sm text-(--c-muted)">
              {gapCount(c.data as ClinicData)} fields missing (see /data/DATA-NEEDED.md)
            </p>
            {built ? (
              <p class="mt-2 text-sm">
                Demo link:
                <a href={demoPath(c.data as ClinicData)} class="font-mono text-xs underline underline-offset-4">
                  {demoPath(c.data as ClinicData)}
                </a>
              </p>
            ) : (
              <p class="mt-2 text-sm text-(--c-muted)">Demo link appears when the block template is built.</p>
            )}
          </li>
        ))}
      </ul>
    )
  }
</HqLayout>
