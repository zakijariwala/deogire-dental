---
/**
 * Plastic-surgery block template (config/blocks.json): the base skeleton
 * plus procedure_detail and safety_credentials:
 *   hero → services_grid → procedure_detail → safety_credentials →
 *   about_doctor → why_us → gallery(gated) → hours_location →
 *   contact_cta → footer
 * ProcedureDetail renders only when services exist so the DATA NEEDED
 * panel for services appears once, in the grid.
 */
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/inter';
import DemoLayout from '../layouts/DemoLayout.astro';
import DemoHeader from '../components/DemoHeader.astro';
import Hero from '../components/Hero.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import ProcedureDetail from '../components/ProcedureDetail.astro';
import SafetyCredentials from '../components/SafetyCredentials.astro';
import AboutDoctor from '../components/AboutDoctor.astro';
import WhyUs from '../components/WhyUs.astro';
import Gallery from '../components/Gallery.astro';
import HoursLocation from '../components/HoursLocation.astro';
import ContactCta from '../components/ContactCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { blockMeta, complianceAllows, has, paletteFor, type ClinicData } from '../lib/site';

interface Props {
  clinic: ClinicData;
}
const { clinic } = Astro.props;

const palette = paletteFor(clinic.palette_ref ?? clinic.block_id);
const meta = blockMeta(clinic.block_id);
const specialty = (clinic.specialty as string) ?? meta.specialty;
const title = has(clinic, 'meta_title')
  ? (clinic.meta_title as string)
  : `${clinic.display_name ?? 'Clinic preview'} | ${specialty}`;

const showAboutDoctor =
  has(clinic, 'doctor_name') || has(clinic, 'qualifications') || has(clinic, 'bio') || has(clinic, 'years_experience');
const showWhyUs = has(clinic, 'usp') || has(clinic, 'years_experience') || has(clinic, 'rating') || has(clinic, 'languages');
---

<DemoLayout title={title} palette={palette}>
  <DemoHeader clinic={clinic} />
  <main>
    <Hero clinic={clinic} specialty={specialty} />
    <ServicesGrid clinic={clinic} />
    {has(clinic, 'services') && <ProcedureDetail clinic={clinic} />}
    <SafetyCredentials clinic={clinic} />
    {showAboutDoctor && <AboutDoctor clinic={clinic} />}
    {showWhyUs && <WhyUs clinic={clinic} />}
    {complianceAllows(clinic, 'before_after') && <Gallery clinic={clinic} />}
    <HoursLocation clinic={clinic} />
    <ContactCta clinic={clinic} />
  </main>
  <SiteFooter clinic={clinic} />
</DemoLayout>
