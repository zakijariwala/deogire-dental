---
/**
 * ENT block template (config/blocks.json): the generic services grid is
 * replaced by a symptom-led grid (ear / nose / throat / sinus / voice).
 * Grouping is presentation-only; supplied services are never padded.
 */
import '@fontsource-variable/ibm-plex-sans';
import DemoLayout from '../layouts/DemoLayout.astro';
import DemoHeader from '../components/DemoHeader.astro';
import Hero from '../components/Hero.astro';
import GroupedServicesGrid from '../components/GroupedServicesGrid.astro';
import AboutDoctor from '../components/AboutDoctor.astro';
import WhyUs from '../components/WhyUs.astro';
import HoursLocation from '../components/HoursLocation.astro';
import ContactCta from '../components/ContactCta.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { blockMeta, has, paletteFor, type ClinicData } from '../lib/site';

interface Props {
  clinic: ClinicData;
}
const { clinic } = Astro.props;

const palette = paletteFor(clinic.palette_ref ?? clinic.block_id);
const meta = blockMeta(clinic.block_id);
const specialty = (clinic.specialty as string) ?? meta.specialty;
const title = has(clinic, 'meta_title')
  ? (clinic.meta_title as string)
  : `${clinic.display_name ?? 'Clinic preview'} | ${specialty}`;

const symptomGroups = [
  { label: 'Ear', keywords: ['ear', 'hearing', 'tinnitus', 'otitis', 'wax'] },
  { label: 'Nose', keywords: ['nose', 'nasal', 'rhin', 'septum', 'smell'] },
  { label: 'Throat', keywords: ['throat', 'tonsil', 'swallow', 'pharyn', 'adenoid'] },
  { label: 'Sinus', keywords: ['sinus'] },
  { label: 'Voice', keywords: ['voice', 'vocal', 'laryn', 'hoarse'] },
];

const showAboutDoctor =
  has(clinic, 'doctor_name') || has(clinic, 'qualifications') || has(clinic, 'bio') || has(clinic, 'years_experience');
const showWhyUs = has(clinic, 'usp') || has(clinic, 'years_experience') || has(clinic, 'rating') || has(clinic, 'languages');
---

<DemoLayout title={title} palette={palette}>
  <DemoHeader clinic={clinic} />
  <main>
    <Hero clinic={clinic} specialty={specialty} />
    <GroupedServicesGrid clinic={clinic} heading="Care by symptom area" groups={symptomGroups} fallbackLabel="General ENT care" />
    {showAboutDoctor && <AboutDoctor clinic={clinic} />}
    {showWhyUs && <WhyUs clinic={clinic} />}
    <HoursLocation clinic={clinic} />
    <ContactCta clinic={clinic} />
  </main>
  <SiteFooter clinic={clinic} />
</DemoLayout>
