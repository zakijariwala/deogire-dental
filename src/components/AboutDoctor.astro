---
/**
 * Renders only when at least one doctor field is supplied; the template skips
 * it entirely otherwise (optional sections degrade by omission, not filler).
 * council_reg_no gets an inline gap marker when absent because credentials
 * displayed without a registration number is a QA flag.
 */
import DataNeeded from './DataNeeded.astro';
import { has, type ClinicData } from '../lib/site';

interface Props {
  clinic: ClinicData;
}
const { clinic } = Astro.props;

const facts: { label: string; value: string }[] = [];
if (has(clinic, 'qualifications')) facts.push({ label: 'Qualifications', value: clinic.qualifications as string });
if (has(clinic, 'council_reg_no')) facts.push({ label: 'Registration no.', value: clinic.council_reg_no as string });
if (has(clinic, 'years_experience')) facts.push({ label: 'In practice', value: `${clinic.years_experience} years` });
if (has(clinic, 'languages')) facts.push({ label: 'Consults in', value: (clinic.languages as string[]).join(', ') });
---

<section class="border-t border-(--c-text)/10 bg-(--c-surface)">
  <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-16 md:grid-cols-12 md:py-20">
    <div class="md:col-span-4">
      {
        has(clinic, 'headshot') ? (
          <img src={clinic.headshot as string} alt={(clinic.doctor_name as string) ?? 'Doctor'} class="aspect-square w-full rounded-2xl object-cover" loading="lazy" />
        ) : (
          <DataNeeded fields={['headshot']} source="client" />
        )
      }
    </div>
    <div class="md:col-span-8">
      <h2 class="font-(family-name:--font-heading) text-3xl font-semibold text-(--c-text) md:text-4xl">
        {has(clinic, 'doctor_name') ? clinic.doctor_name : 'About the doctor'}
      </h2>
      {has(clinic, 'bio') && <p class="mt-5 max-w-[65ch] leading-relaxed text-(--c-muted)">{clinic.bio}</p>}
      {
        facts.length > 0 && (
          <dl class="mt-8 grid grid-cols-1 gap-x-10 gap-y-5 sm:grid-cols-2">
            {facts.map((f) => (
              <div>
                <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-(--c-muted)">{f.label}</dt>
                <dd class="mt-1 text-(--c-text)">{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        !has(clinic, 'council_reg_no') && (
          <div class="mt-6 max-w-md">
            <DataNeeded compact fields={['council_reg_no']} source="client" hint="Required before go-live." />
          </div>
        )
      }
    </div>
  </div>
</section>
