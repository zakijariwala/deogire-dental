---
/**
 * Plastic-surgery safety block: credentials are the trust core of this
 * specialty, so unlike other optional sections it renders a DATA NEEDED
 * panel rather than disappearing when empty. Facts only — no safety claims
 * are composed on the clinic's behalf (rule 1; superiority language is
 * compliance-gated regardless, rule 3).
 */
import DataNeeded from './DataNeeded.astro';
import { has, type ClinicData } from '../lib/site';

interface Props {
  clinic: ClinicData;
}
const { clinic } = Astro.props;

const facts: { label: string; value: string }[] = [];
if (has(clinic, 'qualifications')) facts.push({ label: 'Qualifications', value: clinic.qualifications as string });
if (has(clinic, 'council_reg_no')) facts.push({ label: 'Council registration', value: clinic.council_reg_no as string });
if (has(clinic, 'years_experience')) facts.push({ label: 'In practice', value: `${clinic.years_experience} years` });
---

<section class="border-t border-(--c-text)/10">
  <div class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <h2 class="font-(family-name:--font-heading) text-3xl font-semibold text-(--c-text) md:text-4xl">Credentials and safety</h2>
    {
      facts.length > 0 ? (
        <dl class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-3">
          {facts.map((f) => (
            <div class="rounded-2xl border border-(--c-text)/10 bg-(--c-surface) p-6">
              <dt class="text-xs font-semibold uppercase tracking-[0.12em] text-(--c-muted)">{f.label}</dt>
              <dd class="mt-2 text-lg font-semibold text-(--c-text)">{f.value}</dd>
            </div>
          ))}
        </dl>
      ) : (
        <div class="mt-8 max-w-2xl">
          <DataNeeded
            fields={['qualifications', 'council_reg_no', 'years_experience']}
            source="client"
            hint="Intake Q2 to Q4. Verified credentials are the trust core of a surgical practice page."
          />
        </div>
      )
    }
  </div>
</section>
